# development | preview | production. Production validation is fail-closed.
APP_ENV=development

# Web requests use the provider's pooled URL. Workers/migrations use a direct URL.
# The local values are identical and match docker-compose.yml.
DATABASE_URL=postgresql://federal_intel:federal_intel@localhost:5432/federal_intel
PLATFORM_DATABASE_DIRECT_URL=postgresql://federal_intel:federal_intel@localhost:5432/federal_intel
DATABASE_POOL_MAX=10

# Public federal sources. USAspending does not require an API key.
USA_SPENDING_BASE_URL=https://api.usaspending.gov
SAM_API_KEY=
INGESTION_OVERLAP_DAYS=3
RECONCILIATION_DAYS=30
INGESTION_PAGE_LIMIT=100
INGESTION_BATCH_SIZE=500
BACKFILL_CACHE_DIR=.backfill-cache
BACKFILL_MAX_DOWNLOAD_BYTES=

# Required only for SEC EDGAR collection. SEC fair-access guidance requires a
# descriptive organization/application and contact, for example:
# Federal Ledger data-team@example.com
SEC_USER_AGENT=

# Required before historical writes. Set from the provider's current project limit;
# do not copy a stale plan assumption. Neon Free is 1 GiB as of 2026-10-02.
DATABASE_CAPACITY_BYTES=1000000000
DATABASE_CAPACITY_WARNING_FRACTION=0.60
DATABASE_CAPACITY_STOP_FRACTION=0.72
DATABASE_CAPACITY_CRITICAL_FRACTION=0.90

# Auth.js architecture. DEV_AUTH=true supplies a local user without credentials.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DEV_AUTH=true
DEV_USER_EMAIL=developer@example.test

# Stripe is optional. Keep billing disabled until live products and webhook handling are configured.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOCAL_MONTHLY=
STRIPE_PRICE_LOCAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ANALYST_MONTHLY=
DEV_STRIPE=true

# Required for the authenticated internal data-health endpoint in production.
INTERNAL_HEALTH_TOKEN=

# Alert events always persist. Outbound delivery remains disabled unless a
# separately reviewed email provider is configured in a future change.
ALERT_EMAIL_ENABLED=false

# Emergency-only production escape hatch. Keep false in normal operation.
ALLOW_UNSAFE_PRODUCTION_MOCKS=false

# Explicit local opt-in required by scripts/generate_scale_data.py.
ALLOW_BENCHMARK_DATA=false

# free | local | pro | analyst | organization
DEV_PLAN=pro

# Canonical public URL used by sitemap and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
